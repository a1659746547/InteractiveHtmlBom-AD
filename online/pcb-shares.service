[Unit]
Description=PcbDoc expiring shares
After=network.target

[Service]
User=www
Group=www
WorkingDirectory=/opt/pcb-shares
ExecStart=/usr/bin/python3 /opt/pcb-shares/share_server.py
Restart=on-failure
StateDirectory=pcb-shares
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pcb-shares

[Install]
WantedBy=multi-user.target
